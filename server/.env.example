PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/test_pet_booking_database
# MONGO_URI remains supported for older local environments.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Set these only when creating an administrator account.
# ADMIN_NAME=#Tên của admin: Quản trị viên (Ví dụ)
# ADMIN_EMAIL=#Email của admin: admin@example.com (Ví dụ)
# ADMIN_PASSWORD=#Mật khẩu của admin: thay-bang-mat-khau-manh-tu-8-ky-tu (Ví dụ)




