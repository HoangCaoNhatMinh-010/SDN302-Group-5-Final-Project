PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pawcare_db
# MONGO_URI remains supported for older local environments.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Set these only when creating an administrator account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
